{
  "name": "@typeonly/validator-cli",
  "version": "1.1.3",
  "description": "A CLI to validate JSON files, using TypeScript typing definitions.",
  "author": "Paroi",
  "type": "module",
  "scripts": {
    "prepublishOnly": "npm run build",
    "clear": "rimraf dist/*",
    "tsc": "tsc",
    "tsc:watch": "tsc --watch",
    "build": "npm run clear && npm run tsc",
    "lint": "biome check . --json-formatter-enabled=false"
  },
  "dependencies": {
    "@typeonly/validator": "^1.1.2",
    "command-line-args": "^6.0.2",
    "command-line-usage": "^7.0.4",
    "typeonly": "^1.1.3"
  },
  "devDependencies": {
    "@types/command-line-args": "^5.2.3",
    "@types/command-line-usage": "^5.0.4",
    "@types/node": "^26.6.11",
    "rimraf": "^6.1.4",
    "typescript": "^7.0.2"
  },
  "bin": "dist/cli.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paleo/typeonly.git"
  },
  "homepage": "https://github.com/paleo/typeonly/tree/master/packages/validator-cli",
  "license": "CC0-1.0",
  "keywords": [
    "typescript",
    "json",
    "validation"
  ]
}
