{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "sourceMap": false,
    "lib": ["esnext"],
    "types": ["node"],
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": "src",
    "noEmitOnError": true,
    "declaration": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
